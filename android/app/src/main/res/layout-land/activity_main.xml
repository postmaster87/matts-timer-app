<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/tabTimer"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="TIMER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/tabSw"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="STOPWATCH"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <Button
                android:id="@+id/togSound"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:text="SND" />

            <Button
                android:id="@+id/togVibe"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:text="VIB" />
        </LinearLayout>

        <!-- body: presets on the left, stage on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/presetBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/digitsBox"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/stageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="READY"
                        android:textColor="@color/dim"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.22" />

                    <TextView
                        android:id="@+id/digits"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="0:35"
                        android:textColor="@color/text"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="24sp"
                        android:autoSizeMaxTextSize="@dimen/digits_max"
                        android:autoSizeStepGranularity="1sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/lapsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/lapsBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <FrameLayout
                    android:id="@+id/barTrack"
                    android:layout_width="match_parent"
                    android:layout_height="7dp">

                    <View
                        android:id="@+id/barFill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- the two big ones, full width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGo"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:text="START"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <Button
                android:id="@+id/btnMid"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="RESET"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/btnAlt"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="RESTART"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </LinearLayout>

    <!-- custom length keypad -->
    <LinearLayout
        android:id="@+id/padOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM  ·  MIN : SEC"
                android:textColor="@color/dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.22" />

            <TextView
                android:id="@+id/padVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="00:00"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/padKeys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/padCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/pad_btn_h"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/padSet"
                android:layout_width="0dp"
                android:layout_height="@dimen/pad_btn_h"
                android:layout_weight="1.4"
                android:layout_marginStart="12dp"
                android:text="SET &amp; START"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
