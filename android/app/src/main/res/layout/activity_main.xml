<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- header: mode tabs + sound / vibration toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/tabTimer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="TIMER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/tabSw"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="STOPWATCH"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/tabAlarm"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="ALARM"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <Button
                android:id="@+id/togSound"
                android:layout_width="58dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:text="SND" />

            <Button
                android:id="@+id/togVibe"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:text="VIB" />
        </LinearLayout>

        <!-- preset tiles are built in code (3 x 3) -->
        <LinearLayout
            android:id="@+id/presetBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- stage -->
        <LinearLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:clipToOutline="true">

            <LinearLayout
                android:id="@+id/digitsBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/stageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:maxLines="1"
                    android:text="READY"
                    android:textColor="@color/dim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22" />

                <TextView
                    android:id="@+id/digits"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0:35"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="26sp"
                    android:autoSizeMaxTextSize="@dimen/digits_max"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/lapsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/lapsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <FrameLayout
                android:id="@+id/barTrack"
                android:layout_width="match_parent"
                android:layout_height="8dp">

                <View
                    android:id="@+id/barFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- ALARM tab: status, warnings, the list, sound, ADD ALARM -->
        <LinearLayout
            android:id="@+id/alarmPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/alarmStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/alarmNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:maxLines="1"
                android:textColor="@color/green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:visibility="gone" />

            <TextView
                android:id="@+id/warnNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center"
                android:text="NOTIFICATIONS OFF  ·  TAP TO ALLOW"
                android:textColor="@color/amber"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/warnFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center"
                android:text="FULL SCREEN OFF  ·  TAP TO ALLOW"
                android:textColor="@color/amber"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/warnArm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center"
                android:text="ALARM COULD NOT BE SET"
                android:textColor="@color/amber"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:id="@+id/alarmList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <Button
                android:id="@+id/alarmSound"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alarm_sound_h"
                android:layout_marginTop="10dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/alarmAdd"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_h"
                android:layout_marginTop="10dp"
                android:text="ADD ALARM"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- the two big ones -->
        <LinearLayout
            android:id="@+id/btnRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGo"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:text="START"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <Button
                android:id="@+id/btnMid"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="RESET"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/btnAlt"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="RESTART"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </LinearLayout>

    <!-- set the clock: two wheels, MIN : SEC. Flick, or tap a number and type it -->
    <LinearLayout
        android:id="@+id/pickOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="14dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SET THE CLOCK  ·  MIN : SEC"
            android:textColor="@color/dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <NumberPicker
                android:id="@+id/pickMin"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_wheel_h"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text=":"
                android:textColor="@color/dim"
                android:textSize="40sp"
                android:textStyle="bold" />

            <NumberPicker
                android:id="@+id/pickSec"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_wheel_h"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_btn_h"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pickSet"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_btn_h"
                android:layout_weight="1.4"
                android:layout_marginStart="12dp"
                android:text="SET &amp; START"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- alarm editor: HOUR : MIN wheels, AM / PM, the days, CANCEL / DELETE / SAVE -->
    <LinearLayout
        android:id="@+id/editOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="14dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SET THE ALARM  ·  HOUR : MIN"
            android:textColor="@color/dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <NumberPicker
                android:id="@+id/editHour"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_wheel_h"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text=":"
                android:textColor="@color/dim"
                android:textSize="40sp"
                android:textStyle="bold" />

            <NumberPicker
                android:id="@+id/editMin"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_wheel_h"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/editAm"
                    android:layout_width="76dp"
                    android:layout_height="@dimen/ampm_h"
                    android:text="AM"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/editPm"
                    android:layout_width="76dp"
                    android:layout_height="@dimen/ampm_h"
                    android:layout_marginTop="10dp"
                    android:text="PM"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- S M T W T F S, built in code -->
        <LinearLayout
            android:id="@+id/editDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_btn_h"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/editDelete"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="DELETE"
                android:textSize="19sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/editSave"
                android:layout_width="0dp"
                android:layout_height="@dimen/pick_btn_h"
                android:layout_weight="1.4"
                android:layout_marginStart="12dp"
                android:text="SAVE"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
