<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- header: mode tabs + sound / vibration toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/tabTimer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="TIMER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/tabSw"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="STOPWATCH"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:letterSpacing="0.06"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <Button
                android:id="@+id/togSound"
                android:layout_width="58dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:text="SND" />

            <Button
                android:id="@+id/togVibe"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:text="VIB" />
        </LinearLayout>

        <!-- preset tiles are built in code (3 x 3) -->
        <LinearLayout
            android:id="@+id/presetBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- stage -->
        <LinearLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:clipToOutline="true">

            <LinearLayout
                android:id="@+id/digitsBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/stageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="READY"
                    android:textColor="@color/dim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22" />

                <TextView
                    android:id="@+id/digits"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0:35"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="26sp"
                    android:autoSizeMaxTextSize="@dimen/digits_max"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/lapsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/lapsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <FrameLayout
                android:id="@+id/barTrack"
                android:layout_width="match_parent"
                android:layout_height="8dp">

                <View
                    android:id="@+id/barFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- the two big ones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGo"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:text="START"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <Button
                android:id="@+id/btnMid"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="RESET"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/btnAlt"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="RESTART"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </LinearLayout>

    <!-- custom length keypad -->
    <LinearLayout
        android:id="@+id/padOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CUSTOM  ·  MIN : SEC"
            android:textColor="@color/dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <TextView
            android:id="@+id/padVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="00:00"
            android:textColor="@color/text"
            android:textSize="58sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <LinearLayout
            android:id="@+id/padKeys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/padCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/pad_btn_h"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/padSet"
                android:layout_width="0dp"
                android:layout_height="@dimen/pad_btn_h"
                android:layout_weight="1.4"
                android:layout_marginStart="12dp"
                android:text="SET &amp; START"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
